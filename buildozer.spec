[app]

# (str) Title of your application
title = Nova

# (str) Package name
package.name = nova

# (str) Package domain
package.domain = org.nova

# (str) Source code directory
source.dir = .

# (list) Source files to include
source.include_exts = py,png,jpg,jpeg,kv,atlas,json,html,css,js

# (str) Application version
version = 1.0

# (list) Python requirements
requirements = python3,kivy

# (str) Orientation
orientation = portrait

# (bool) Fullscreen
fullscreen = 0


[buildozer]

# (int) Log level
log_level = 2

# (bool) Display warning if running as root
warn_on_root = 1
